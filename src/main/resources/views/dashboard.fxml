<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane fitToWidth="true" style="-fx-background: transparent; -fx-background-color: transparent;"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.nexora.controller.DashboardController">

    <VBox spacing="16.0">
        <padding>
            <Insets top="24.0" right="24.0" bottom="24.0" left="24.0"/>
        </padding>

        <!-- Cabecera de la Vista -->
        <HBox alignment="CENTER_LEFT" spacing="12.0">
            <VBox spacing="2.0">
                <Label text="Panel de Control Principal" styleClass="view-title"/>
                <Label text="Resumen ejecutivo de inventario, ventas y alertas críticas" styleClass="view-subtitle"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="🔄 Actualizar Datos" styleClass="btn-secondary" onAction="#cargarDatosDashboard"/>
        </HBox>

        <!-- Tarjetas KPI -->
        <GridPane hgap="16.0" vgap="16.0">
            <columnConstraints>
                <ColumnConstraints percentWidth="25.0"/>
                <ColumnConstraints percentWidth="25.0"/>
                <ColumnConstraints percentWidth="25.0"/>
                <ColumnConstraints percentWidth="25.0"/>
            </columnConstraints>

            <!-- KPI 1: Ventas Hoy -->
            <VBox spacing="4.0" styleClass="card, kpi-accent-green" GridPane.columnIndex="0">
                <Label text="VENTAS DE HOY" styleClass="kpi-title"/>
                <Label fx:id="lblVentasHoy" text="S/. 0.00" styleClass="kpi-value" style="-fx-text-fill: #10b981;"/>
            </VBox>

            <!-- KPI 2: Ventas del Mes -->
            <VBox spacing="4.0" styleClass="card, kpi-accent-blue" GridPane.columnIndex="1">
                <Label text="VENTAS DEL MES" styleClass="kpi-title"/>
                <Label fx:id="lblVentasMes" text="S/. 0.00" styleClass="kpi-value" style="-fx-text-fill: #2563eb;"/>
            </VBox>

            <!-- KPI 3: Catálogo Activo -->
            <VBox spacing="4.0" styleClass="card, kpi-accent-purple" GridPane.columnIndex="2">
                <Label text="PRODUCTOS ACTIVOS" styleClass="kpi-title"/>
                <Label fx:id="lblProductosTotal" text="0" styleClass="kpi-value" style="-fx-text-fill: #8b5cf6;"/>
            </VBox>

            <!-- KPI 4: Alertas de Stock Bajo -->
            <VBox spacing="4.0" styleClass="card, kpi-accent-red" GridPane.columnIndex="3">
                <Label text="ALERTAS DE REPOSICIÓN" styleClass="kpi-title"/>
                <Label fx:id="lblAlertasBajoStock" text="0" styleClass="kpi-value" style="-fx-text-fill: #ef4444;"/>
            </VBox>
        </GridPane>

        <!-- Fila de Gráfica y Tabla de Alertas -->
        <GridPane hgap="16.0" vgap="16.0">
            <columnConstraints>
                <ColumnConstraints percentWidth="55.0"/>
                <ColumnConstraints percentWidth="45.0"/>
            </columnConstraints>

            <!-- Gráfico de Ventas -->
            <VBox spacing="10.0" styleClass="card" GridPane.columnIndex="0" prefHeight="340.0">
                <Label text="Ventas Recientes por Día (S/.)" style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #334155;"/>
                <BarChart fx:id="chartVentas" legendVisible="false" animated="false" VBox.vgrow="ALWAYS">
                    <xAxis>
                        <CategoryAxis label="Fecha"/>
                    </xAxis>
                    <yAxis>
                        <NumberAxis label="Monto (S/.)"/>
                    </yAxis>
                </BarChart>
            </VBox>

            <!-- Tabla de Stock Crítico -->
            <VBox spacing="10.0" styleClass="card" GridPane.columnIndex="1" prefHeight="340.0">
                <HBox alignment="CENTER_LEFT">
                    <Label text="⚠️ Productos por Reponer (Stock Mínimo)" style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #b91c1c;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                </HBox>

                <TableView fx:id="tblStockCritico" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colCodigoCritico" text="Código" prefWidth="75.0"/>
                        <TableColumn fx:id="colNombreCritico" text="Producto" prefWidth="150.0"/>
                        <TableColumn fx:id="colStockActual" text="Stock" prefWidth="60.0"/>
                        <TableColumn fx:id="colStockMinimo" text="Mínimo" prefWidth="65.0"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                </TableView>
            </VBox>
        </GridPane>

        <!-- Registro de Eventos Observer -->
        <VBox spacing="8.0" styleClass="card">
            <Label text="🔔 Bitácora de Alertas del Patrón Observer" style="-fx-font-weight: bold; -fx-font-size: 13px; -fx-text-fill: #334155;"/>
            <ListView fx:id="lstBitacoraObserver" prefHeight="95.0"/>
        </VBox>

    </VBox>
</ScrollPane>
