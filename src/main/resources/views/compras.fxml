<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="16.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.nexora.controller.CompraController">

    <padding>
        <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="12.0">
        <VBox spacing="2.0">
            <Label text="Compras y Reabastecimiento a Proveedores" styleClass="view-title"/>
            <Label text="Ingreso de mercadería, incremento atómico de stock y trazabilidad de costos" styleClass="view-subtitle"/>
        </VBox>
    </HBox>

    <GridPane hgap="16.0" VBox.vgrow="ALWAYS">
        <columnConstraints>
            <ColumnConstraints percentWidth="55.0"/>
            <ColumnConstraints percentWidth="45.0"/>
        </columnConstraints>

        <!-- PANEL IZQUIERDO: Formulario de Nueva Compra -->
        <VBox spacing="12.0" styleClass="card" GridPane.columnIndex="0">
            <Label text="📥 Registrar Nueva Compra" style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #1e293b;"/>

            <HBox spacing="10.0">
                <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                    <Label text="Proveedor:*"/>
                    <ComboBox fx:id="cmbProveedor" maxWidth="Infinity" promptText="Seleccione Proveedor..."/>
                </VBox>
                <VBox spacing="4.0" prefWidth="180.0">
                    <Label text="N° Comprobante/Factura:"/>
                    <TextField fx:id="txtComprobante" promptText="F001-000452"/>
                </VBox>
            </HBox>

            <Separator/>

            <!-- Agregar Productos a la compra -->
            <Label text="Agregar Productos al Lote:" style="-fx-font-weight: bold; -fx-text-fill: #475569; -fx-font-size: 12px;"/>
            <HBox spacing="10.0" alignment="BOTTOM_LEFT">
                <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                    <Label text="Producto:"/>
                    <ComboBox fx:id="cmbProducto" maxWidth="Infinity" promptText="Seleccione Producto..."/>
                </VBox>
                <VBox spacing="4.0" prefWidth="90.0">
                    <Label text="Cantidad:"/>
                    <TextField fx:id="txtCantidad" promptText="10"/>
                </VBox>
                <VBox spacing="4.0" prefWidth="110.0">
                    <Label text="P. Compra (S/.):"/>
                    <TextField fx:id="txtPrecioCompra" promptText="2.50"/>
                </VBox>
                <Button text="➕ Agregar" styleClass="btn-primary" onAction="#agregarItemCompra"/>
            </HBox>

            <!-- Tabla de Ítems de la Compra -->
            <TableView fx:id="tblItemsCompra" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colItemProducto" text="Producto" prefWidth="170.0"/>
                    <TableColumn fx:id="colItemCantidad" text="Cantidad" prefWidth="70.0"/>
                    <TableColumn fx:id="colItemPrecio" text="P. Unit" prefWidth="80.0"/>
                    <TableColumn fx:id="colItemSubtotal" text="Subtotal" prefWidth="90.0"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>

            <HBox alignment="CENTER_RIGHT" spacing="10.0">
                <Button text="Quitar Ítem" styleClass="btn-secondary" onAction="#quitarItemCompra"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="Total Compra:" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
                <Label fx:id="lblTotalCompra" text="S/. 0.00" style="-fx-font-weight: bold; -fx-font-size: 18px; -fx-text-fill: #10b981;"/>
            </HBox>

            <Button text="📦 REGISTRAR COMPRA Y CARGAR AL INVENTARIO" maxWidth="Infinity" prefHeight="40.0"
                    styleClass="btn-success" onAction="#guardarCompra"/>
        </VBox>

        <!-- PANEL DERECHO: Historial de Compras -->
        <VBox spacing="12.0" styleClass="card" GridPane.columnIndex="1">
            <HBox alignment="CENTER_LEFT">
                <Label text="📜 Historial de Compras Realizadas" style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #1e293b;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="🔄" styleClass="btn-secondary" onAction="#cargarHistorialCompras"/>
            </HBox>

            <TableView fx:id="tblHistorialCompras" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colHistId" text="ID" prefWidth="50.0"/>
                    <TableColumn fx:id="colHistProveedor" text="Proveedor" prefWidth="140.0"/>
                    <TableColumn fx:id="colHistComprobante" text="Comprobante" prefWidth="95.0"/>
                    <TableColumn fx:id="colHistFecha" text="Fecha" prefWidth="110.0"/>
                    <TableColumn fx:id="colHistTotal" text="Total (S/.)" prefWidth="80.0"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
        </VBox>
    </GridPane>
</VBox>
