<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="16.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.nexora.controller.POSController">

    <padding>
        <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
    </padding>

    <!-- Título y Encabezado -->
    <HBox alignment="CENTER_LEFT" spacing="12.0">
        <VBox spacing="2.0">
            <Label text="Punto de Venta (POS)" styleClass="view-title"/>
            <Label text="Venta rápida con carrito en vivo y estrategia dinámica de descuentos" styleClass="view-subtitle"/>
        </VBox>
    </HBox>

    <!-- Contenido Principal: Catálogo a la izquierda, Carrito a la derecha -->
    <GridPane hgap="16.0" VBox.vgrow="ALWAYS">
        <columnConstraints>
            <ColumnConstraints percentWidth="52.0"/>
            <ColumnConstraints percentWidth="48.0"/>
        </columnConstraints>

        <!-- PANEL IZQUIERDO: Búsqueda y Selección de Productos -->
        <VBox spacing="12.0" styleClass="card" GridPane.columnIndex="0">
            <Label text="📦 Catálogo de Productos Disponibles" style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #334155;"/>

            <!-- Filtros de búsqueda -->
            <HBox spacing="10.0" alignment="CENTER_LEFT">
                <TextField fx:id="txtBuscarProducto" promptText="🔍 Buscar por nombre o código..." HBox.hgrow="ALWAYS" onKeyReleased="#filtrarProductos"/>
                <ComboBox fx:id="cmbFiltroCategoria" promptText="Todas las Categorías" prefWidth="180.0" onAction="#filtrarProductos"/>
            </HBox>

            <!-- Tabla de Productos del POS -->
            <TableView fx:id="tblCatalogoPOS" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colCatCodigo" text="Código" prefWidth="85.0"/>
                    <TableColumn fx:id="colCatNombre" text="Producto" prefWidth="170.0"/>
                    <TableColumn fx:id="colCatTipo" text="Tipo" prefWidth="80.0"/>
                    <TableColumn fx:id="colCatStock" text="Stock" prefWidth="60.0"/>
                    <TableColumn fx:id="colCatPrecio" text="Precio" prefWidth="75.0"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>

            <HBox alignment="CENTER_RIGHT" spacing="10.0">
                <Label text="Cantidad a agregar:"/>
                <Spinner fx:id="spnCantidadAgregar" prefWidth="80.0" editable="true"/>
                <Button text="➕ Agregar al Carrito" styleClass="btn-primary" onAction="#agregarAlCarrito"/>
            </HBox>
        </VBox>

        <!-- PANEL DERECHO: Carrito de Compras, Estrategia de Descuento y Cobro -->
        <VBox spacing="12.0" styleClass="card" GridPane.columnIndex="1">
            <HBox alignment="CENTER_LEFT">
                <Label text="🛒 Carrito de Venta" style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #334155;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Limpiar Carrito" styleClass="btn-secondary" onAction="#limpiarCarrito"/>
            </HBox>

            <!-- Tabla del Carrito -->
            <TableView fx:id="tblCarrito" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colCarNombre" text="Producto" prefWidth="160.0"/>
                    <TableColumn fx:id="colCarPrecio" text="P. Unit" prefWidth="70.0"/>
                    <TableColumn fx:id="colCarCantidad" text="Cant" prefWidth="60.0"/>
                    <TableColumn fx:id="colCarSubtotal" text="Subtotal" prefWidth="80.0"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>

            <HBox alignment="CENTER_RIGHT">
                <Button text="❌ Quitar Ítem Seleccionado" styleClass="btn-danger" onAction="#quitarDelCarrito"/>
            </HBox>

            <Separator/>

            <!-- Selector de Patrón Strategy para Descuentos -->
            <VBox spacing="6.0" style="-fx-background-color: #f1f5f9; -fx-padding: 10px; -fx-background-radius: 8px;">
                <Label text="🎯 Estrategia de Descuento (Patrón Strategy):" style="-fx-font-weight: bold; -fx-text-fill: #1e293b; -fx-font-size: 11px;"/>
                <ComboBox fx:id="cmbEstrategiaDescuento" maxWidth="Infinity" onAction="#cambiarEstrategiaDescuento"/>
            </VBox>

            <!-- Resumen Financiero de la Venta -->
            <VBox spacing="4.0">
                <HBox alignment="CENTER_LEFT">
                    <Label text="Subtotal:" style="-fx-text-fill: #64748b;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblSubtotal" text="S/. 0.00" style="-fx-font-weight: bold; -fx-text-fill: #334155;"/>
                </HBox>
                <HBox alignment="CENTER_LEFT">
                    <Label text="Descuento aplicado:" style="-fx-text-fill: #64748b;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblDescuento" text="- S/. 0.00" style="-fx-font-weight: bold; -fx-text-fill: #10b981;"/>
                </HBox>
                <Separator/>
                <HBox alignment="CENTER_LEFT">
                    <Label text="TOTAL A COBRAR:" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblTotal" text="S/. 0.00" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2563eb;"/>
                </HBox>
            </VBox>

            <Button text="💳  REGISTRAR VENTA Y COBRAR" maxWidth="Infinity" prefHeight="42.0"
                    styleClass="btn-success" style="-fx-font-size: 14px;" onAction="#procesarCobro"/>
        </VBox>
    </GridPane>
</VBox>
